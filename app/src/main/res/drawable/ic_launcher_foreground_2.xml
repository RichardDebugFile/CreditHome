<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Techo dinámico superior -->
    <path
        android:pathData="M26,48 L54,24 L82,48"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="36"
                android:endX="82"
                android:endY="36"
                android:type="linear">
                <item android:offset="0.0" android:color="#10B981"/>
                <item android:offset="1.0" android:color="#34D399"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Base y pilar central integrado -->
    <path
        android:pathData="M38,56 L54,42 L70,56 L70,82 L38,82 Z"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="62"
                android:endX="70"
                android:endY="62"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8"/>
                <item android:offset="1.0" android:color="#1D4ED8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Marca de balance positiva -->
    <path
        android:pathData="M54,60 L54,72"
        android:strokeWidth="4"
        android:strokeColor="#10B981"
        android:strokeLineCap="round"/>
</vector>