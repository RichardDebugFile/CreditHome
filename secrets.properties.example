# ==============================================================================
# CreditHome - Plantilla de secretos locales
#
# 1. Copia este archivo como 'secrets.properties' en la raíz del proyecto.
# 2. Reemplaza los valores de ejemplo por los tuyos.
#
# 'secrets.properties' está en .gitignore: NUNCA lo subas al repositorio.
# Cada clave también puede definirse como variable de entorno (útil en CI).
#
# Resolución por variante de compilación:
#   <VARIANTE>_<CLAVE>  ->  <CLAVE>  ->  valor por defecto en app/build.gradle.kts
# Variantes: DEBUG, QA, RELEASE
# ==============================================================================

# --- Bóveda criptográfica (cifrado AES de backups y datos sensibles) ---
# IMPORTANTE: cambiar este valor impide descifrar backups creados con el anterior.
# Obligatorio para builds release.
DEBUG_APP_CRYPTO_SALT=cambia-este-salt-de-desarrollo
QA_APP_CRYPTO_SALT=cambia-este-salt-de-qa
RELEASE_APP_CRYPTO_SALT=cambia-este-salt-de-produccion

# --- RabbitMQ (solo si rabbitmq_sync_enabled = true en features.json) ---
DEBUG_RABBITMQ_USER=guest
DEBUG_RABBITMQ_PASSWORD=guest
QA_RABBITMQ_USER=
QA_RABBITMQ_PASSWORD=
RELEASE_RABBITMQ_USER=
RELEASE_RABBITMQ_PASSWORD=
